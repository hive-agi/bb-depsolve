{:paths ["src"]
 :deps {babashka/fs {:mvn/version "0.5.32"}
        babashka/process {:mvn/version "0.6.25"}
        org.babashka/http-client {:mvn/version "0.4.23"}
        org.babashka/cli {:mvn/version "0.8.67"}
        cheshire/cheshire {:mvn/version "6.2.0"}
        io.github.lispyclouds/bblgum {:git/sha "df647fb50f32e05b26e46e58d7249b4798e469e6"}
        io.github.hive-agi/hive-dsl {:git/tag "v0.5.8" :git/sha "755baf5"}
        metosin/malli {:mvn/version "0.20.1"}
        io.github.hive-agi/hive-spi {:mvn/version "0.1.9"}
        io.github.hive-agi/hive-schemas {:mvn/version "0.1.10"}
        io.github.hive-agi/hive-weave {:mvn/version "0.3.1"}}
 :bbin/bin {bb-depsolve {:main-opts ["-m" "bb-depsolve.cli.main"]}}
 :tasks
 {test {:extra-paths ["test"]
        :extra-deps {org.clojure/test.check {:mvn/version "1.1.1"}
                     io.github.hive-agi/hive-test {:git/tag "v0.3.10" :git/sha "6b3a04d"}
                     io.github.cognitect-labs/test-runner
                     {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
        :task (exec 'cognitect.test-runner.api/test)}
  test-model {:task (shell "clojure" "-M:test-model")}
  split {:doc "Apply a namespace split spec from dev/refactor (REPL-driven refactoring)."
         :extra-paths ["dev"]
         :requires ([refactor.split :as split])
         :task (let [spec-ns (or (first *command-line-args*)
                    (throw (ex-info "usage: bb split <spec-ns>  (e.g. refactor.core-split). Specs are one-shot: an applied spec is spent." {})))
        spec (deref (requiring-resolve (symbol spec-ns "spec")))]
    (doseq [[path n] (sort (split/split! spec))]
      (println (format "%-44s %3d forms" path n))))}
  cascade-model {:doc "Model-check the release cascade (recife/TLC)."
                  :task (shell "clojure" "-M:cascade-model")}}}
