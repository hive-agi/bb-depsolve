{:paths ["src"]
 :deps {babashka/fs {:mvn/version "0.5.32"}
        babashka/process {:mvn/version "0.6.25"}
        org.babashka/http-client {:mvn/version "0.4.23"}
        org.babashka/cli {:mvn/version "0.8.67"}
        cheshire/cheshire {:mvn/version "6.2.0"}
        io.github.lispyclouds/bblgum {:git/sha "df647fb50f32e05b26e46e58d7249b4798e469e6"}
        io.github.hive-agi/hive-dsl {:mvn/version "0.5.7"}
        metosin/malli {:mvn/version "0.20.1"}
        io.github.hive-agi/hive-spi {:git/tag "v0.1.9" :git/sha "3c468c4"}
        io.github.hive-agi/hive-schemas {:mvn/version "0.1.10"}}
 :aliases
 {  ;; :build — tools.build entrypoint (clojure -T:build <task>). Canonical hive
  ;; build: jar / jar-aot / install / bump / verify-license / deploy.
  :build {:deps {io.github.clojure/tools.build {:mvn/version "0.10.9"}
                 slipset/deps-deploy {:mvn/version "0.2.2"}}
          :ns-default build}

  :test {:extra-paths ["test"]
         :extra-deps {org.clojure/test.check {:mvn/version "1.1.1"}
                      io.github.hive-agi/hive-test {:git/tag "v0.3.10" :git/sha "6b3a04d"}
                      io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
         :main-opts ["-m" "cognitect.test-runner"]
         :exec-fn cognitect.test-runner.api/test}
  :test-model {:extra-paths ["test-model"]
 :extra-deps {org.clojure/clojure {:mvn/version "1.12.1"}
              pfeodrippe/recife {:mvn/version "0.22.0"}
              io.github.hive-agi/hive-recife {:git/sha "2734b324642afac34fed6803495819343481121f"}
              io.github.hive-agi/hive-spi {:git/tag "v0.1.9" :git/sha "3c468c4"}}
 :main-opts ["-m" "bb-depsolve.sync-model"]}}}
