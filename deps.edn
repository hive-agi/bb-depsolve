{:paths ["src"]
 :deps {babashka/fs {:mvn/version "0.5.34"}
        babashka/process {:mvn/version "0.6.25"}
        org.babashka/http-client {:mvn/version "0.4.24"}
        org.babashka/cli {:mvn/version "0.12.86"}
        cheshire/cheshire {:mvn/version "6.2.0"}
        io.github.lispyclouds/bblgum {:git/sha "df647fb50f32e05b26e46e58d7249b4798e469e6"}
        io.github.hive-agi/hive-dsl {:mvn/version "0.5.15"}
        metosin/malli {:mvn/version "0.20.1"}
        io.github.hive-agi/hive-spi {:mvn/version "0.1.20"}
        io.github.hive-agi/hive-schemas {:mvn/version "0.1.14"}
        io.github.hive-agi/hive-weave {:mvn/version "0.3.1"}
        org.clojure/data.xml {:mvn/version "0.2.0-alpha9"}}
 :aliases
 {  ;; :build — tools.build entrypoint (clojure -T:build <task>). Canonical hive
  ;; build: jar / jar-aot / install / bump / verify-license / deploy.
  :build {:deps {io.github.hive-agi/hive-build {:mvn/version "0.1.9"}}
          :ns-default hive-build.api}

  :test {:extra-paths ["test"]
         :extra-deps {org.clojure/test.check {:mvn/version "1.1.3"}
                      io.github.hive-agi/hive-test {:git/tag "v0.3.12" :git/sha "01b518a"}
                      io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
         :main-opts ["-m" "cognitect.test-runner"]
         :exec-fn cognitect.test-runner.api/test}
  :test-model {:extra-paths ["test-model"]
 :extra-deps {org.clojure/clojure {:mvn/version "1.12.5"}
              pfeodrippe/recife {:mvn/version "0.22.0"}
              io.github.hive-agi/hive-recife {:git/tag "v0.1.5" :git/sha "5b6a2c7"}
              io.github.hive-agi/hive-spi {:mvn/version "0.1.20"}}
 :main-opts ["-m" "bb-depsolve.sync-model"]}
  :dev {:extra-paths ["dev" "test"]
          :extra-deps {rewrite-clj/rewrite-clj {:mvn/version "1.2.55"}
                       org.clojure/test.check {:mvn/version "1.1.3"}}}
  :cascade-model {:extra-paths ["test-model"]
                   :extra-deps {org.clojure/clojure {:mvn/version "1.12.5"}
                                pfeodrippe/recife {:mvn/version "0.22.0"}
                                io.github.hive-agi/hive-recife {:git/tag "v0.1.5" :git/sha "5b6a2c7"}
                                io.github.hive-agi/hive-spi {:mvn/version "0.1.20"}}
                   :main-opts ["-m" "bb-depsolve.cascade-model"]}}}
