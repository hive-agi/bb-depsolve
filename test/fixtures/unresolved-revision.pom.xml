<?xml version="1.0" encoding="UTF-8"?>
<!-- Fixture: real-world style POM that uses the CI-friendly `${revision}`
     property (https://maven.apache.org/maven-ci-friendly.html). When the
     POM is consumed without a flatten-maven-plugin pre-processing step,
     the `${revision}` token leaks through unresolved and would poison
     downstream resolution. bb-depsolve must drop + warn. -->
<project xmlns="http://maven.apache.org/POM/4.0.0">
  <modelVersion>4.0.0</modelVersion>
  <groupId>example.unresolved</groupId>
  <artifactId>sample-parent</artifactId>
  <version>${revision}</version>

  <properties>
    <revision>1.0.0-SNAPSHOT</revision>
    <jackson.version>2.17.0</jackson.version>
  </properties>

  <dependencies>
    <!-- Resolved, must be kept. -->
    <dependency>
      <groupId>org.clojure</groupId>
      <artifactId>clojure</artifactId>
      <version>1.12.0</version>
    </dependency>

    <!-- Resolved, must be kept. -->
    <dependency>
      <groupId>cheshire</groupId>
      <artifactId>cheshire</artifactId>
      <version>5.13.0</version>
    </dependency>

    <!-- Unresolved ${revision}: must be dropped + warned. -->
    <dependency>
      <groupId>example.unresolved</groupId>
      <artifactId>sibling-module</artifactId>
      <version>${revision}</version>
    </dependency>

    <!-- Unresolved property reference: must be dropped + warned. -->
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
      <version>${jackson.version}</version>
    </dependency>
  </dependencies>
</project>
